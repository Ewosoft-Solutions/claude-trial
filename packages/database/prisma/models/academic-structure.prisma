// ============================================
// Academic Structure Models
// ============================================
//
// Schema Design Notes:
//
// 1. AcademicYear:
//    - Tenant-scoped academic years (e.g., "2024-2025")
//    - Start and end dates
//    - Status tracking (active, planned, completed)
//    - Default/current year flag
//
// 2. Term:
//    - Belongs to an AcademicYear
//    - Types: semester, trimester, quarter, etc.
//    - Start and end dates
//    - Order/sequence for display
//    - Status tracking (active, planned, completed)
//
// 3. Course:
//    - Tenant-scoped course catalog
//    - Course code (e.g., "MATH101")
//    - Name, description, category
//    - Grade levels (which grades can take this course)
//    - Credits/hours
//    - Status (active, archived)
//
// 4. Class:
//    - Course offering in a specific term
//    - Section identifier (e.g., "A", "B", "Section 1")
//    - Capacity (max students)
//    - Schedule information (JSONB for flexibility)
//    - Status (active, full, cancelled)
//    - Teacher assignments (many-to-many via ClassTeacher)
//
// See: _requirements/academic-structure.md for complete academic structure design
// ============================================

// AcademicYear - School academic years (e.g., "2024-2025")
model AcademicYear {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String // e.g., "2024-2025", "Academic Year 2024"
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  status      String   @default("planned") // 'active' | 'planned' | 'completed' | 'archived'
  isDefault   Boolean  @default(false) @map("is_default") // Current/default year for the school
  description String?

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms       Term[]
  classes     Class[]
  enrollments Enrollment[]
  assessments Assessment[]

  @@unique([tenantId, name]) // Unique name per tenant
  @@index([tenantId])
  @@index([status])
  @@index([isDefault])
  @@index([startDate, endDate])
  @@map("academic_years")
  @@schema("academic-structure")
}

// Term - Academic terms within an academic year (semester, trimester, quarter, etc.)
model Term {
  id             String   @id @default(uuid())
  academicYearId String   @map("academic_year_id")
  tenantId       String?  @map("tenant_id") // Denormalized from academicYear for RLS + tenant-scoped queries
  name           String // e.g., "Fall Term", "Semester 1", "Trimester 1"
  type           String // 'semester' | 'trimester' | 'quarter' | 'term' | 'custom'
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  order          Int // Sequence/order for display (1, 2, 3, etc.)
  status         String   @default("planned") // 'active' | 'planned' | 'completed' | 'archived'
  description    String?

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classes      Class[]
  enrollments  Enrollment[]
  assessments  Assessment[]

  @@unique([academicYearId, name]) // Unique name per academic year
  @@index([academicYearId])
  @@index([status])
  @@index([order])
  @@index([startDate, endDate])
  @@index([tenantId])
  @@index([tenantId, academicYearId])
  @@map("terms")
  @@schema("academic-structure")
}

// Course - Course catalog (tenant-scoped)
model Course {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  code        String // e.g., "MATH101", "ENG-201"
  name        String // e.g., "Introduction to Algebra"
  description String?
  category    String? // e.g., "Mathematics", "English", "Science"
  subject     String? // Subject area (can be same as category or more specific)

  // Grade Levels - Array of grade levels that can take this course
  // e.g., ["9", "10", "11", "12"] or ["K", "1", "2"] for elementary
  gradeLevels String[] @default([]) @map("grade_levels")

  // Credits/Hours
  credits Decimal? // e.g., 3.0, 4.5
  hours   Decimal? // Contact hours

  // Status
  status String @default("active") // 'active' | 'archived' | 'draft'

  // Metadata
  prerequisites String? // Description or course codes
  objectives    String? // Learning objectives

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes   Class[]
  questions Question[] // Question bank entries for this course

  @@unique([tenantId, code]) // Unique course code per tenant
  @@index([tenantId])
  @@index([status])
  @@index([category])
  @@index([code])
  @@map("courses")
  @@schema("academic-structure")
}

// Class - Course offering in a specific term (section/classroom)
model Class {
  id             String  @id @default(uuid())
  courseId       String  @map("course_id")
  termId         String  @map("term_id")
  academicYearId String  @map("academic_year_id") // Denormalized for easier queries
  tenantId       String? @map("tenant_id") // Denormalized for RLS + tenant-scoped queries

  // Section Information
  section String // e.g., "A", "B", "Section 1", "Morning"
  name    String? // Optional custom name (e.g., "Algebra I - Advanced Section")

  // Capacity and Enrollment
  capacity          Int @default(30) // Maximum number of students
  currentEnrollment Int @default(0) @map("current_enrollment") // Current number enrolled

  // Schedule - JSONB for flexibility (can store complex schedules)
  // Example: { "days": ["Monday", "Wednesday", "Friday"], "time": "09:00-10:30", "room": "Room 101" }
  // Or: [{ "day": "Monday", "startTime": "09:00", "endTime": "10:30", "room": "Room 101" }, ...]
  schedule Json?

  // Location
  room String? // Room/location identifier

  // Status
  status String @default("active") // 'active' | 'full' | 'cancelled' | 'archived'

  // Additional Information
  description String?

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term              Term               @relation(fields: [termId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classTeachers     ClassTeacher[] // Teacher assignments
  enrollments       Enrollment[] // Student enrollments
  assessments       Assessment[] // Assessments/assignments
  attendanceRecords AttendanceRecord[]
  lessons           Lesson[] // Lesson content (learning schema)

  @@unique([courseId, termId, section]) // Unique section per course-term combination
  @@index([courseId])
  @@index([termId])
  @@index([academicYearId])
  @@index([status])
  @@index([room])
  @@index([tenantId])
  @@index([tenantId, termId])
  @@index([tenantId, status])
  @@map("classes")
  @@schema("academic-structure")
}

// ClassTeacher - Many-to-many: Teachers assigned to classes
// Note: This assumes UserTenant (profile) represents teachers
// For now, we'll use userTenantId to reference the teacher's profile
model ClassTeacher {
  id           String  @id @default(uuid())
  classId      String  @map("class_id")
  userTenantId String  @map("user_tenant_id") // Teacher's profile (UserTenant)
  tenantId     String? @map("tenant_id") // Denormalized from class for RLS

  // Role/Assignment Type
  role String @default("teacher") // 'teacher' | 'assistant' | 'co-teacher' | 'substitute'

  // Assignment Dates
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignedBy   String?   @map("assigned_by") // Admin who assigned
  unassignedAt DateTime? @map("unassigned_at")
  unassignedBy String?   @map("unassigned_by")

  // Status
  isActive Boolean @default(true) @map("is_active")

  // Relations
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)

  @@unique([classId, userTenantId]) // One assignment per teacher per class
  @@index([classId])
  @@index([userTenantId])
  @@index([isActive])
  @@index([tenantId])
  @@map("class_teachers")
  @@schema("academic-structure")
}

// ============================================
// WB2-1 · ADR-02 structured academic model (additive over legacy Class/Course)
// ============================================
//
// Stores the class structure as DIMENSIONS — campus · stage · year · stream ·
// section — never a parsed label. "SS1 SCIENCE" and "SS1 ARTS" are two
// ClassSection rows sharing a YearLevel and differing only by Stream; no code
// path derives stage / year / stream from a display string. `displayLabel` is
// COMPOSED by the service from the dimensions and STORED (stable display +
// export), never re-parsed to recover structure. SubjectOffering links an F6
// CurriculumSubject to a section in an academic year/term — the anchor WB2-2
// hangs enrollment / teacher-assignment / electives on.
//
// Tenanting (F6 convention — mirrors curriculum's application tables): every
// table carries tenant_id NOT NULL; external references (tenant, campus,
// academic year/term, curriculum subject) are plain id fields with DB-level FKs
// added in the migration and validated in-service — NOT Prisma relations — so a
// shared/national CurriculumSubject and the cross-schema tenant.campuses row are
// referenced without coupling those models here. The new models relate to EACH
// OTHER via Prisma for ergonomic nested reads. RLS: own + platform on every
// table (db:rls:check). ClassSection.campusId is the target the WB1-6
// AccessScopeService enforces.
// ============================================

// Stage - a curriculum level band (e.g. "Senior Secondary" = SSS). School-wide.
model Stage {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name   String // e.g. "Senior Secondary"
  code   String // short code, unique per tenant (e.g. "SSS")

  // The FIXED band this stage belongs to: 'nursery' | 'primary' | 'secondary'
  // | 'tertiary' | 'special' (see EDUCATION_LEVELS in @workspace/database).
  // Nullable only so existing rows can be backfilled; new stages set it.
  educationLevel String? @map("education_level")
  order  Int    @default(0)
  status String @default("active") // 'active' | 'inactive'

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  yearLevels YearLevel[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, educationLevel])
  @@index([status])
  @@map("stages")
  @@schema("academic-structure")
}

// YearLevel - a year within a stage (e.g. "SS1" under "SSS").
model YearLevel {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  stageId  String @map("stage_id")

  // `name` is the SCHOOL's word for this rung ("Basic 3", "Year 3") and is
  // freely edited. `levelCode` is the fixed national rung it maps to (PRY_3) —
  // never shown, never edited, and what every cross-school comparison, transfer
  // and report keys on. See LEVEL_SPINE in @workspace/database.
  name   String // e.g. "SS1"
  code   String // unique per tenant (e.g. "SS1")

  levelCode String? @map("level_code")
  order  Int    @default(0)
  status String @default("active") // 'active' | 'inactive'

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stage         Stage          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  classSections ClassSection[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, levelCode])
  @@index([stageId])
  @@index([status])
  @@map("year_levels")
  @@schema("academic-structure")
}

// Stream - a pathway / arm-of-study (e.g. "Science", "Arts", "Commercial").
// The dimension that distinguishes SS1 SCIENCE from SS1 ARTS — a structured row,
// not a substring of a class name.
/// Stream = the ARM of a class level (Science / Arts / A / B / Gold). Named
/// "stream" in ADR-02; most Nigerian schools say "arm", so the UI says arm and
/// carries `description` + `aliases` to explain it in the school's own words.
model Stream {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name   String // e.g. "Science"
  code   String // unique per tenant (e.g. "SCI")

  /// What this arm means here — e.g. "Science track, offers Further Maths".
  description String?
  /// Other names this arm answers to, for search + import matching.
  aliases     String[] @default([])
  order  Int    @default(0)
  status String @default("active") // 'active' | 'inactive'

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  classSections ClassSection[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@map("streams")
  @@schema("academic-structure")
}

// ClassSection - the concrete arm a student sits in: a (campus, year level,
// stream?) triple plus a section name. Belongs to a Campus (the WB1-6 scope
// target). `displayLabel` is composed by the service and stored, never parsed.
model ClassSection {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  campusId    String  @map("campus_id") // tenant.campuses(id) — DB FK, WB1-6 scope target
  yearLevelId String  @map("year_level_id")
  streamId    String? @map("stream_id")

  name         String // the arm, e.g. "A", "Gold"
  displayLabel String @map("display_label") // COMPOSED from the dimensions + stored; never re-parsed
  capacity     Int    @default(30)
  status       String @default("active") // 'active' | 'archived'

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  yearLevel        YearLevel         @relation(fields: [yearLevelId], references: [id], onDelete: Cascade)
  stream           Stream?           @relation(fields: [streamId], references: [id], onDelete: SetNull)
  subjectOfferings SubjectOffering[]

  // One arm per (campus, year level, stream, name). NULL stream (an unstreamed
  // junior class) is de-duplicated by an in-service check (Postgres treats NULL
  // as distinct in a unique index).
  @@unique([tenantId, campusId, yearLevelId, streamId, name])
  @@index([tenantId])
  @@index([campusId])
  @@index([yearLevelId])
  @@index([streamId])
  @@index([status])
  @@map("class_sections")
  @@schema("academic-structure")
}

// SubjectOffering - an F6 CurriculumSubject offered to a ClassSection in an
// academic year (optionally a term). The anchor WB2-2 hangs enrollment /
// teacher-assignment / electives on. `curriculumSubjectId` is a soft reference
// to curriculum.curriculum_subjects (nullable-tenant, may be shared national
// content) validated in-service — same convention as CurriculumAdoption.
model SubjectOffering {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  classSectionId String  @map("class_section_id")
  academicYearId String  @map("academic_year_id") // academic-structure.academic_years(id) — DB FK
  termId         String? @map("term_id") // academic-structure.terms(id) — DB FK, null = year-long

  curriculumSubjectId String @map("curriculum_subject_id") // soft ref → curriculum.curriculum_subjects(id)
  subjectLabel        String @map("subject_label") // subject name resolved at creation, stored for display/export

  isElective Boolean @default(false) @map("is_elective")
  status     String  @default("active") // 'active' | 'archived'

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, curriculumSubjectId, termId])
  @@index([tenantId])
  @@index([classSectionId])
  @@index([academicYearId])
  @@index([curriculumSubjectId])
  @@map("subject_offerings")
  @@schema("academic-structure")
}

// ============================================
// WB2-2 · Enrollment support: academic profile + offering-teacher assignment
// ============================================
// The tenant's academic PROFILE selects how students join what they study:
// 'class' (K-12 — enroll into a ClassSection, take its offerings as a set) vs
// 'course' (tertiary/TVET — register per SubjectOffering). Effective-dated (F6
// flavour). If a tenant has no profile, the resolver falls back to deriving the
// model from Tenant.schoolType. OfferingTeacher assigns a teacher to an OFFERING
// (#30) — never a free-text label. Both tenant-owned (RLS own+platform); external
// ids (campus, offering, teacher profile) validated in-service (F6 convention).
// ============================================

// AcademicProfile - selects the enrollment model for a tenant (optionally a campus).
model AcademicProfile {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  campusId String? @map("campus_id") // null = tenant-wide; set = per-campus override

  name            String
  enrollmentModel String  @map("enrollment_model") // 'class' (K-12) | 'course' (tertiary)
  isDefault       Boolean @default(false) @map("is_default")
  status          String  @default("active") // 'active' | 'inactive'

  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([status])
  @@map("academic_profiles")
  @@schema("academic-structure")
}

// OfferingTeacher - a teacher (UserTenant profile) assigned to a SubjectOffering.
model OfferingTeacher {
  id                String @id @default(uuid())
  tenantId          String @map("tenant_id")
  subjectOfferingId String @map("subject_offering_id") // academic-structure.subject_offerings(id)
  userTenantId      String @map("user_tenant_id") // teacher's profile

  role         String    @default("teacher") // 'teacher' | 'assistant'
  isActive     Boolean   @default(true) @map("is_active")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignedBy   String?   @map("assigned_by")
  unassignedAt DateTime? @map("unassigned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subjectOfferingId, userTenantId])
  @@index([tenantId])
  @@index([subjectOfferingId])
  @@index([userTenantId])
  @@index([isActive])
  @@map("offering_teachers")
  @@schema("academic-structure")
}
