// ============================================
// Finance Models
// ============================================
//
// FeeInvoice: a billing record issued to a student (or an applicant) for a
//   term's fees, itemised by FeeInvoiceLine and reduced by FeeAdjustment.
// Payment: a RECEIPT — money received from a payer — allocated across one or
//   more invoices by PaymentAllocation; any excess becomes an AccountCredit.
//
// The balance is always DERIVED (gross − applied adjustments − allocations −
// applied credit) and never stored-and-edited; corrections are new rows.
//
// All tenant-scoped (tenant_id NOT NULL) in the "finance" schema and covered
// by RLS (each migration applies the policy explicitly so db:rls:check passes
// from day one). The double-entry ledger these subledger events post into
// lives in `general-ledger.prisma` (same schema, ADR-10).
//
// invoice status: 'draft' | 'issued' | 'paid' | 'partial' | 'overdue' | 'cancelled'
// payment status: 'pending' | 'completed' | 'failed' | 'refunded'
// payment method: 'transfer' | 'card' | 'cash' | 'cheque'
// ============================================

/// A durable family billing account (P2). Invoices — and, in P3, payments and
/// credits — attach to this persistent id, so billing history survives
/// guardianship changes. Membership and payers are TEMPORAL (effective ranges),
/// answering "who was in this family / who paid, on date D". Auto-derived from
/// shared primary/billing-guardian clusters, with an operator merge/split tool
/// for blended families and edge cases. Not a genealogy tree — a billing account.
model BillingHousehold {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name             String
  primaryPayerName String? @map("primary_payer_name") // snapshot for display

  // Set when auto-created from a guardian cluster (the guardian's Person id).
  // Keeps the derive pass idempotent — one auto household per primary guardian —
  // and leaves manually-created households (null) untouched. Postgres treats
  // NULLs as distinct, so many manual households coexist under this unique.
  derivedFromGuardianId String? @map("derived_from_guardian_id")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members  HouseholdMember[]
  payers   HouseholdPayer[]
  invoices FeeInvoice[]
  payments Payment[]
  credits  AccountCredit[]

  @@unique([tenantId, derivedFromGuardianId])
  @@index([tenantId])
  @@map("billing_households")
  @@schema("finance")
}

/// A student's membership in a household, effective-dated so a transfer ends one
/// membership (effectiveTo set) and opens another without losing history.
model HouseholdMember {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  householdId String  @map("household_id")
  studentId   String  @map("student_id")
  studentName String? @map("student_name") // snapshot for display

  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  household BillingHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([householdId])
  @@index([tenantId, studentId])
  @@map("household_members")
  @@schema("finance")
}

/// A payer on a household (a guardian Person), effective-dated. `role` marks the
/// primary vs. secondary payer at a point in time.
model HouseholdPayer {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  householdId String  @map("household_id")
  guardianId  String  @map("guardian_id") // Person id of the guardian
  payerName   String? @map("payer_name") // snapshot for display
  role        String  @default("primary") // primary | secondary

  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  household BillingHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([householdId])
  @@index([tenantId, guardianId])
  @@map("household_payers")
  @@schema("finance")
}

model FeeInvoice {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  invoiceNumber String @map("invoice_number")

  // The family account this invoice belongs to (P2, optional). Lets a payment
  // settle across a household's invoices (P3) and history survive guardianship
  // changes; unset invoices still bill the student directly.
  householdId String? @map("household_id")

  // Nullable so an ADMISSION-fee invoice can be billed to an applicant who is
  // not yet a student (WB3-5). On convert-to-student the applicant's admission
  // invoices are re-keyed to the new student id, so student billing is unchanged.
  studentId String? @map("student_id")
  classId   String? @map("class_id")

  // Set when this invoice bills an admission fee (application/acceptance fee) for
  // an application that has no student yet (WB3-5). Lets the admissions detail
  // page + the AR list find/badge the invoice, and lets convert-to-student
  // re-key every admission invoice to the resulting student in one pass.
  admissionApplicationId String? @map("admission_application_id")

  // Denormalized payer snapshot. Finance is decoupled from the student schema
  // (no relation, by the "not a custodian" ADR), so the invoices list searches
  // and sorts on this column instead of an impossible cross-schema join. Set at
  // invoice creation; captures the student's (or applicant's) name as billed.
  studentName String? @map("student_name")

  // Term / period
  termName  String? @map("term_name")
  termYear  Int?    @map("term_year")
  termCycle Int?    @map("term_cycle")

  issuedDate DateTime? @map("issued_date") @db.Date
  dueDate    DateTime? @map("due_date") @db.Date

  // Amounts in minor units (kobo) — avoids float issues.
  // `amountPaid` is a CACHE of Σ allocations + Σ applied credit, maintained by
  // the allocation writer in the same transaction so the list can sort on it.
  // The authoritative figure is always derived from the allocation rows.
  amountDue  Int @default(0) @map("amount_due")
  amountPaid Int @default(0) @map("amount_paid")

  status String @default("draft") // draft | issued | paid | partial | overdue | cancelled

  notes String?

  // Audit
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  household          BillingHousehold?   @relation(fields: [householdId], references: [id], onDelete: SetNull)
  allocations        PaymentAllocation[]
  creditApplications CreditApplication[]
  lines              FeeInvoiceLine[]
  adjustments        FeeAdjustment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, householdId])
  @@index([tenantId, admissionApplicationId])
  @@index([studentId])
  @@map("fee_invoices")
  @@schema("finance")
}

/// A RECEIPT: money received from a payer on a date, then ALLOCATED across one
/// or more invoices (WB5-3). It is deliberately not linked to a single invoice —
/// a parent paying once for two children is the normal case, not the exception,
/// and the old one-payment-one-invoice shape could not express it. What each
/// naira settled lives in `PaymentAllocation`; anything unallocated becomes an
/// `AccountCredit` rather than fake income.
model Payment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  receiptNumber String @map("receipt_number")

  /// The family account the money came in on (optional — a receipt can still be
  /// taken for a single student with no household).
  householdId String? @map("household_id")
  /// Snapshot of who paid, so a reprinted receipt reads the same years later.
  payerName   String? @map("payer_name")

  method    String   @default("transfer") // transfer | card | cash | cheque
  paidAt    DateTime @map("paid_at") @db.Date
  amount    Int // minor units (kobo)
  reference String? // payment gateway ref / cheque number

  status String @default("completed") // pending | completed | failed | refunded

  notes String?

  // Audit
  recordedBy String?  @map("recorded_by")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  /// Set by the client for one submission of the checkout form. A retry after a
  /// lost response carries the SAME key and returns the receipt already
  /// recorded, instead of taking the family's money twice. Unique per tenant
  /// where present (partial index — most rows are null).
  idempotencyKey String? @map("idempotency_key")

  /// Reprints are counted (and audited) rather than forbidden — a family losing
  /// a receipt is routine; a receipt quietly printed forty times is not.
  reprintCount    Int       @default(0) @map("reprint_count")
  lastReprintedAt DateTime? @map("last_reprinted_at")

  // Relations
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  household   BillingHousehold?   @relation(fields: [householdId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]
  credits     AccountCredit[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([tenantId, householdId])
  @@index([tenantId, status])
  @@index([tenantId, paidAt])
  @@map("payments")
  @@schema("finance")
}

/// What one receipt settled on one invoice. The many-to-many is real: an invoice
/// collects allocations over time (installments), a receipt spreads across
/// invoices (siblings). An allocation never exceeds the invoice's outstanding
/// balance, and the sum of a receipt's allocations never exceeds its amount —
/// both enforced in the one writer, inside the same transaction.
model PaymentAllocation {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  paymentId String @map("payment_id")
  invoiceId String @map("invoice_id")

  // No default: the database CHECKs amount > 0, so a 0 default would advertise
  // a value every insert would be rejected for.
  amount Int // kobo

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([paymentId])
  @@map("payment_allocations")
  @@schema("finance")
}

/// Unapplied credit — an accounts-receivable CREDIT BALANCE, not stored value
/// and not money we hold (ADR-05: we are not a payment custodian). It arises
/// when a payer pays more than the invoices they settled, and it is drawn down
/// against future invoices. `remaining` is maintained by the writer alongside
/// append-only `CreditApplication` rows, so the draw-down history stays intact.
/// Paying credit back out in cash is deliberately out of scope for v1.
model AccountCredit {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  householdId String? @map("household_id")
  studentId   String? @map("student_id")

  /// overpayment | opening_balance | adjustment
  source String @default("overpayment")
  amount Int    @default(0) // kobo, as received
  remaining Int @default(0) // kobo, still undrawn

  reason    String?
  paymentId String? @map("payment_id") // the receipt that created it

  status String @default("active") // active | exhausted | void

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  household    BillingHousehold?   @relation(fields: [householdId], references: [id], onDelete: SetNull)
  payment      Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  applications CreditApplication[]

  @@index([tenantId])
  @@index([tenantId, householdId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("account_credits")
  @@schema("finance")
}

/// One draw-down of a credit against an invoice. Append-only: reversing a
/// wrongly-applied credit is a new row on the other side, never a delete.
model CreditApplication {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  creditId  String @map("credit_id")
  invoiceId String @map("invoice_id")

  // No default — see PaymentAllocation.amount.
  amount Int // kobo

  appliedBy String?  @map("applied_by")
  appliedAt DateTime @default(now()) @map("applied_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credit  AccountCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  invoice FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([creditId])
  @@map("credit_applications")
  @@schema("finance")
}

/// A gap-aware, never-reused document sequence (ADR-05 Q23). One row per
/// tenant + kind + scope (the fiscal year), incremented atomically inside the
/// issuing transaction. A rolled-back transaction therefore leaves a GAP rather
/// than handing the number to someone else — which is the property an auditor
/// wants: a missing receipt number is visible, a duplicated one is not.
model FinanceNumberSequence {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  kind     String // receipt | invoice | journal
  scopeKey String @map("scope_key") // fiscal year, e.g. "2026"
  prefix   String

  nextValue Int @default(1) @map("next_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, scopeKey])
  @@index([tenantId])
  @@map("finance_number_sequences")
  @@schema("finance")
}

/// Managed catalogue of billable fee items (Tuition, Bus, Books, …). Pre-seeded
/// per tenant; invoice lines reference these so billing stays consistent and
/// reportable (revenue by fee type), and discount policies can target an item.
model FeeItem {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  code String // stable slug, unique per tenant (e.g. "tuition", "bus")
  name String

  /// How this item is priced, the way a till prices stock.
  /// 'fixed'  — the price lives here and is pulled onto the line read-only.
  ///            defaultAmount must be set before it can be billed.
  /// 'open'   — priced per line at entry (damages, miscellaneous). The amount
  ///            typed on the line is the point, not an override.
  /// Changing a FIXED item's price on a line is a deliberate, audited override
  /// (see FinanceCatalogueService.updateLine), never a free-text field.
  pricingMode   String  @default("fixed") @map("pricing_mode")
  defaultAmount Int?    @map("default_amount") // kobo; required when fixed
  active        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines            FeeInvoiceLine[]
  discountPolicies DiscountPolicy[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("fee_items")
  @@schema("finance")
}

/// A line item on a fee invoice — the itemisation behind the invoice total. The
/// invoice's gross is the sum of its lines; the balance is derived from gross −
/// adjustments − payments (never stored-and-edited).
model FeeInvoiceLine {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  invoiceId String @map("invoice_id")
  feeItemId String @map("fee_item_id")

  description String?
  amount      Int     @default(0) // kobo, per unit
  quantity    Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     FeeInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem     FeeItem         @relation(fields: [feeItemId], references: [id], onDelete: Restrict)
  adjustments FeeAdjustment[]

  @@index([tenantId])
  @@index([invoiceId])
  @@index([feeItemId])
  @@map("fee_invoice_lines")
  @@schema("finance")
}

/// A standing discount rule (sibling %, early-bird promo, scholarship band). The
/// authority IS the policy, so it auto-applies to anyone who qualifies — but
/// ACTIVATING one is a maker-checker action (it silently reduces revenue for all
/// matching invoices). v1 targeting: an optional fee item + a fixed amount OR a
/// percentage; richer conditions (grade, sibling count) come later.
model DiscountPolicy {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name       String
  type       String // discount | scholarship
  feeItemId  String? @map("fee_item_id") // null = applies to the whole invoice
  amount     Int? // kobo, fixed amount off (mutually exclusive with percentBps)
  percentBps Int?    @map("percent_bps") // basis points off, 10000 = 100%
  reason     String?

  // Activation lifecycle (maker-checker).
  status            String    @default("pending") // pending | active | inactive
  approvalRequestId String?   @map("approval_request_id")
  createdBy         String?   @map("created_by")
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeItem     FeeItem?        @relation(fields: [feeItemId], references: [id], onDelete: SetNull)
  adjustments FeeAdjustment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([feeItemId])
  @@map("discount_policies")
  @@schema("finance")
}

/// A reduction applied to an invoice: a discount / waiver / scholarship /
/// correction. `source` records the authority — `policy` (auto, auditable by
/// policyId) or `discretionary` (needs maker-checker sign-off, requester ≠
/// approver). Immutable once `applied`; a reversal is a new `correction`.
model FeeAdjustment {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  invoiceId String  @map("invoice_id")
  lineId    String? @map("line_id") // optional: adjust one line rather than the invoice

  type   String // discount | waiver | scholarship | correction
  source String // policy | discretionary
  amount Int     @default(0) // kobo, the resolved amount off
  reason String?

  policyId String? @map("policy_id") // set when source = policy

  // Approval lifecycle (discretionary uses maker-checker; policy is pre-approved).
  status            String    @default("pending") // pending | approved | rejected | cancelled | applied
  // `cancelled` = the maker withdrew their own request. Distinct from
  // `rejected`, which means a second authority refused it.
  approvalRequestId String?   @map("approval_request_id")
  requestedBy       String?   @map("requested_by")
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  appliedAt         DateTime? @map("applied_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice FeeInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  line    FeeInvoiceLine? @relation(fields: [lineId], references: [id], onDelete: Cascade)
  policy  DiscountPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@index([lineId])
  @@index([policyId])
  @@map("fee_adjustments")
  @@schema("finance")
}
