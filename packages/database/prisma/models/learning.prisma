// ============================================
// Learning Content Models (lesson substrate for the AI tutor)
// ============================================
//
// Schema Design Notes:
//
// 1. Lesson:
//    - Teacher-authored unit of teaching content attached to a Class
//      (a Course offering in a term) — the retrieval scope for the
//      Academic AI tutor (docs/ai-integration-plan.md Step 4/5).
//    - status: 'draft' | 'published' | 'archived'
//
// 2. LessonMaterial:
//    - One uploaded file (PDF/DOCX/PPTX/TXT in v1). The binary lives
//      behind StorageProvider (apps/api) — rows carry the storage key,
//      mime type and the extraction pipeline status.
//    - extractionStatus: 'pending' | 'processing' | 'completed' | 'failed'
//
// 3. MaterialChunk:
//    - Retrieval unit: extracted text chunk + pgvector embedding.
//    - embedding is Unsupported("vector(1024)") — prisma-client-js cannot
//      read/write it; all embedding writes and similarity queries go
//      through raw SQL (see LearningRetrievalService in apps/api).
//    - tenantId AND lessonId are denormalized on every chunk so both RLS
//      and the (tenantId, lessonId) retrieval scope are enforceable in a
//      single predicate — this is the tutor's core privacy boundary.
//
// All three tables are tenant-scoped (tenant_id NOT NULL) in the
// "learning" schema and covered by RLS (the migration applies the
// tenant_isolation policy explicitly so db:rls:check passes).
// ============================================

/// A lesson in the LIBRARY: authored once against a curriculum subject and
/// reusable by every section that teaches it. What a particular class actually
/// teaches is a `LessonInstance` pointing here — so a school with four arms
/// authors once instead of four times, and the material's chunks + embeddings
/// are computed once and shared.
model Lesson {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// The library anchor: an F6 `curriculum.curriculum_subjects` row (soft ref,
  /// validated in-service — the F6 tenanting convention). Nullable only while
  /// legacy class-keyed lessons are being migrated.
  curriculumSubjectId String? @map("curriculum_subject_id")
  chapterId           String? @map("chapter_id")

  /// DEPRECATED legacy pointer to the labelled-bag `Class` this lesson was
  /// authored against before the library existed. Read-only; retired once the
  /// backfill has moved every row onto `curriculumSubjectId`.
  classId String? @map("class_id")

  /// Tile art for the grid/list toggle students get over lessons.
  thumbnailKey String? @map("thumbnail_key")

  title       String
  description String?
  content     String? // Rich-text lesson note body (teacher-authored)
  order       Int     @default(0) // Display sequence within the class
  status      String  @default("draft") // 'draft' | 'published' | 'archived'

  // Review workflow — content is only visible to students once approved
  // AND published. 'draft' | 'pending_review' | 'approved' | 'rejected'
  reviewStatus         String    @default("draft") @map("review_status")
  submittedForReviewAt DateTime? @map("submitted_for_review_at")
  reviewedBy           String?   @map("reviewed_by") // UserTenant id of reviewer
  reviewedAt           DateTime? @map("reviewed_at")
  reviewNote           String?   @map("review_note")

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class     Class?           @relation(fields: [classId], references: [id], onDelete: Cascade)
  chapter   LessonChapter?   @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  materials LessonMaterial[]
  chunks    MaterialChunk[]
  instances LessonInstance[]

  @@index([tenantId])
  @@index([tenantId, classId])
  @@index([tenantId, curriculumSubjectId])
  @@index([tenantId, chapterId])
  @@index([tenantId, status])
  @@index([tenantId, reviewStatus])
  @@map("lessons")
  @@schema("learning")
}

model LessonMaterial {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  lessonId String @map("lesson_id")

  title      String // Display name (defaults to the original file name)
  fileName   String @map("file_name") // Original upload file name
  mimeType   String @map("mime_type")
  sizeBytes  Int    @map("size_bytes")
  storageKey String @map("storage_key") // Key under StorageProvider

  // 'document' | 'video' | 'image' | 'audio' — only documents run the
  // extraction/embedding pipeline; media is stored and streamed as-is.
  category String @default("document")

  // Review workflow — uploads default to pending_review (invisible to
  // students until approved). 'pending_review' | 'approved' | 'rejected'
  reviewStatus String    @default("pending_review") @map("review_status")
  reviewedBy   String?   @map("reviewed_by") // UserTenant id of reviewer
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNote   String?   @map("review_note")

  extractionStatus String  @default("pending") @map("extraction_status") // 'pending' | 'processing' | 'completed' | 'failed' | 'skipped'
  extractionError  String? @map("extraction_error")
  chunkCount       Int     @default(0) @map("chunk_count")

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  chunks MaterialChunk[]

  @@index([tenantId])
  @@index([tenantId, lessonId])
  @@index([tenantId, extractionStatus])
  @@index([tenantId, reviewStatus])
  @@map("lesson_materials")
  @@schema("learning")
}

model MaterialChunk {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  lessonId   String @map("lesson_id") // Denormalized retrieval scope (with tenantId)
  materialId String @map("material_id")

  chunkIndex Int                          @map("chunk_index") // Position within the source material
  content    String
  embedding  Unsupported("vector(1024)")? // Written via raw SQL only; null until embedded
  metadata   Json? // Source detail (e.g. character offsets, embedding model)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson   Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  material LessonMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, lessonId])
  @@index([materialId, chunkIndex])
  @@map("material_chunks")
  @@schema("learning")
}

/// A chapter groups the library's lessons under a curriculum subject — the unit
/// a teacher and a student both think in ("Chapter 3: Fractions"). Assessments
/// and assignments hang off the chapter in the reference systems we studied;
/// that arrives with the evaluation slice.
model LessonChapter {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// curriculum.curriculum_subjects(id) — soft ref, validated in-service.
  curriculumSubjectId String @map("curriculum_subject_id")

  title       String
  description String?
  /// Tile art, so a chapter list can render as a grid.
  thumbnailKey String? @map("thumbnail_key")
  order        Int     @default(0)
  status       String  @default("active") // 'active' | 'archived'

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([tenantId])
  @@index([tenantId, curriculumSubjectId])
  @@index([tenantId, status])
  @@map("lesson_chapters")
  @@schema("learning")
}

/// What a PARTICULAR class is taught: a library lesson instantiated against one
/// `SubjectOffering` (section × subject × year/term). The instance is where
/// per-class reality lives — when it is scheduled, whether this arm has covered
/// it yet, and any local adaptation — while the lesson body, materials and
/// embeddings stay shared in the library.
///
/// Deliberately NOT a copy of the lesson. Copying per section is what forces a
/// teacher to re-author for every arm and re-embed the same PDF four times.
model LessonInstance {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  lessonId String @map("lesson_id")
  /// academic-structure.subject_offerings(id) — DB-level FK, no Prisma relation
  /// (the WB2 convention keeps this module decoupled from that one).
  subjectOfferingId String @map("subject_offering_id")

  /// Per-class adaptation. Null means "use the library lesson's own value".
  titleOverride String? @map("title_override")
  /// This arm's own notes — what was emphasised, what to revisit.
  notes String?

  scheduledFor DateTime? @map("scheduled_for")
  taughtAt     DateTime? @map("taught_at")

  status String @default("planned") // 'planned' | 'taught' | 'skipped'
  order  Int    @default(0)

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// One instance per (library lesson, offering) — instantiating twice is a
  /// mistake, not a second copy.
  @@unique([lessonId, subjectOfferingId])
  @@index([tenantId])
  @@index([tenantId, subjectOfferingId])
  @@index([tenantId, status])
  @@index([lessonId])
  @@map("lesson_instances")
  @@schema("learning")
}
