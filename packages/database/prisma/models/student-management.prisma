// ============================================
// Student Management Models
// ============================================
//
// Schema Design Notes:
//
// 1. Student:
//    - Links to UserTenant (profile) - represents a student's profile at a school
//    - Tenant-scoped student records
//    - Student number (unique per tenant)
//    - Enrollment status tracking
//    - Flexible JSONB fields for personal, academic, health, emergency contacts
//
// 2. Enrollment:
//    - Links Student to Class (course offering in a term)
//    - Academic year context
//    - Enrollment status (active, dropped, completed, failed)
//    - Final grade and credits earned
//    - Unique per student-class-academic year
//
// See: _requirements/features-functionality.md for student management requirements
// ============================================

// Student - Student profile at a school (linked to UserTenant)
model Student {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  userTenantId String  @map("user_tenant_id") // Student's profile (UserTenant)
  personId     String? @unique @map("person_id") // F1: the human this student profile anchors to (0..1, back-filled)

  // Student Identification
  studentNumber   String // e.g., "STU-2024-001", unique per tenant
  admissionNumber String?   @map("admission_number")
  admissionDate   DateTime? @map("admission_date")

  // Current Status
  gradeLevel       String? @map("grade_level") // Current grade level (e.g., "9", "10", "K", "1")
  enrollmentStatus String  @default("active") @map("enrollment_status") // 'active' | 'inactive' | 'suspended' | 'graduated' | 'transferred' | 'withdrawn'

  // Flexible Data Fields (JSONB)
  personalInfo      Json? @default("{}") @map("personal_info") // Personal details
  academicInfo      Json? @default("{}") @map("academic_info") // Academic history
  healthInfo        Json? @default("{}") @map("health_info") // Health records, allergies, medications
  emergencyContacts Json? @default("[]") @map("emergency_contacts") // Emergency contact information
  specialNeeds      Json? @default("[]") @map("special_needs") // Special needs, accommodations

  // Status Dates
  enrollmentDate DateTime? @map("enrollment_date")
  graduationDate DateTime? @map("graduation_date")
  withdrawalDate DateTime? @map("withdrawal_date")
  transferDate   DateTime? @map("transfer_date")

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userTenant          UserTenant           @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  person              Person?              @relation("StudentPerson", fields: [personId], references: [id], onDelete: SetNull)
  enrollments         Enrollment[]
  guardians           StudentGuardian[]    @relation("StudentGuardianStudent")
  attendanceRecords   AttendanceRecord[]
  transportAssignment TransportAssignment?
  libraryLoans        LibraryBook[]
  healthRecord        HealthRecord?

  @@unique([tenantId, studentNumber]) // Unique student number per tenant
  @@index([tenantId])
  @@index([userTenantId])
  @@index([enrollmentStatus])
  @@index([gradeLevel])
  @@index([studentNumber])
  // Tenant-leading composites for the common list filters (each query hits
  // only its tenant's slice — keeps lists fast as the table grows).
  @@index([tenantId, enrollmentStatus])
  @@index([tenantId, gradeLevel])
  @@map("students")
  @@schema("student-management")
}

// Enrollment - Student enrollment in a class (course offering)
model Enrollment {
  id             String  @id @default(uuid())
  studentId      String  @map("student_id")
  classId        String  @map("class_id")
  academicYearId String  @map("academic_year_id")
  termId         String  @map("term_id") // Denormalized for easier queries
  tenantId       String? @map("tenant_id") // Denormalized for RLS + tenant-scoped queries

  // Enrollment Details
  enrollmentDate DateTime @default(now()) @map("enrollment_date")
  status         String   @default("active") // 'active' | 'dropped' | 'completed' | 'failed'

  // Academic Results
  finalGrade    String?  @map("final_grade") // Final letter grade or percentage
  creditsEarned Decimal? @map("credits_earned") // Credits earned (e.g., 3.0, 4.5)
  gpaPoints     Decimal? @map("gpa_points") // GPA points for this course

  // Additional Information
  notes String?

  // Status Dates
  droppedDate   DateTime? @map("dropped_date")
  completedDate DateTime? @map("completed_date")

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  student               Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class                 Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear          AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term                  Term                   @relation(fields: [termId], references: [id], onDelete: Cascade)
  grades                Grade[] // Grades/assessments for this enrollment
  assessmentSubmissions AssessmentSubmission[] // Online assessment attempts

  @@unique([studentId, classId, academicYearId]) // Unique enrollment per student-class-year
  @@index([studentId])
  @@index([classId])
  @@index([academicYearId])
  @@index([termId])
  @@index([status])
  @@index([enrollmentDate])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@index([tenantId, studentId])
  @@map("enrollments")
  @@schema("student-management")
}

// StudentGuardian - Links guardians (UserTenant) to students
// DEPRECATED (WB1-4) — legacy student→account caregiver link (Father/Mother/
// Both). Superseded by person.GuardianRelationship (Person→Person), which the
// People-directory Guardians tab and guardianship management now use. Kept
// read-only for back-compat with older student records; do not add new
// authority/consent fields here — extend GuardianRelationship instead.
model StudentGuardian {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  studentId          String  @map("student_id")
  userTenantId       String  @map("user_tenant_id")
  guardianIdentifier String? @map("guardian_identifier")

  relationship    String  @default("parent")
  isPrimary       Boolean @default(false) @map("is_primary")
  legalGuardian   Boolean @default(false) @map("legal_guardian")
  contactPriority Int?    @map("contact_priority")
  notes           String?

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  student  Student    @relation("StudentGuardianStudent", fields: [studentId], references: [id], onDelete: Cascade)
  guardian UserTenant @relation("StudentGuardianGuardian", fields: [userTenantId], references: [id], onDelete: Cascade)
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, userTenantId])
  @@unique([tenantId, guardianIdentifier])
  @@index([tenantId])
  @@index([studentId])
  @@index([userTenantId])
  @@index([guardianIdentifier])
  @@map("student_guardians")
  @@schema("student-management")
}

// ============================================
// WB2-2 · Enrollment / registration / election (over the WB2-1 structure)
// ============================================
// Joins a Student to what they study, the way the tenant's AcademicProfile
// demands — ADDITIVE over the legacy Enrollment(→ labeled-bag Class):
//   • SectionEnrollment (K-12)     — Student joins a ClassSection; the section's
//                                     SubjectOfferings are their subject set.
//   • CourseRegistration (tertiary)— Student registers per SubjectOffering.
//   • StudentSubjectElection (C036)— a K-12 elective CHOICE over an OFFERING
//                                     (never a free-text subject).
// All reference the WB2-1 structure by id (DB-level FKs, validated in-service —
// F6 convention); tenant-owned with own+platform RLS.
// ============================================

// SectionEnrollment - K-12: a Student enrolled in a ClassSection for an academic year.
model SectionEnrollment {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  studentId      String @map("student_id")
  classSectionId String @map("class_section_id") // academic-structure.class_sections(id)
  academicYearId String @map("academic_year_id")

  status     String    @default("active") // 'active' | 'transferred' | 'withdrawn' | 'completed'
  enrolledAt DateTime  @default(now()) @map("enrolled_at")
  endedAt    DateTime? @map("ended_at")
  endReason  String?   @map("end_reason")

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, classSectionId, academicYearId])
  @@index([tenantId])
  @@index([studentId])
  @@index([classSectionId])
  @@index([status])
  @@index([tenantId, classSectionId])
  @@map("section_enrollments")
  @@schema("student-management")
}

// CourseRegistration - tertiary/TVET: a Student registered for a SubjectOffering.
model CourseRegistration {
  id                String @id @default(uuid())
  tenantId          String @map("tenant_id")
  studentId         String @map("student_id")
  subjectOfferingId String @map("subject_offering_id") // academic-structure.subject_offerings(id)

  status       String    @default("registered") // 'registered' | 'dropped' | 'completed'
  registeredAt DateTime  @default(now()) @map("registered_at")
  endedAt      DateTime? @map("ended_at")

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, subjectOfferingId])
  @@index([tenantId])
  @@index([studentId])
  @@index([subjectOfferingId])
  @@index([status])
  @@map("course_registrations")
  @@schema("student-management")
}

// StudentSubjectElection - C036: a K-12 elective CHOICE over an OFFERING (isElective).
model StudentSubjectElection {
  id                String @id @default(uuid())
  tenantId          String @map("tenant_id")
  studentId         String @map("student_id")
  subjectOfferingId String @map("subject_offering_id")

  status    String   @default("elected") // 'elected' | 'withdrawn'
  electedAt DateTime @default(now()) @map("elected_at")

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, subjectOfferingId])
  @@index([tenantId])
  @@index([studentId])
  @@index([subjectOfferingId])
  @@map("student_subject_elections")
  @@schema("student-management")
}

// ============================================
// WB2-3 · Student lifecycle: registration · transfer · withdrawal · graduation
// ============================================
// Every change to WHERE a student sits is a durable, explainable lifecycle
// EVENT with history — never a delete-and-retype. StudentPlacementHistory is
// the effective-dated ledger of placement SPANS: one row per span a student sat
// in a (campus, class section, academic year). A transfer CLOSES the current
// span (effectiveTo) and OPENS a new one — both survive, with dates, so the
// prior placement is never destroyed (workbench-2 scenario 3). Withdrawal /
// graduation close the current span and flip the Student's enrollmentStatus. The
// WB2-2 SectionEnrollment stays the "current membership" projection; this ledger
// is the authoritative, auditable history the lifecycle service writes alongside
// it. External ids (campus, class section, academic year, section enrollment)
// are DB-level FKs validated in-service (F6 convention). RLS: own + platform.
// ============================================

model StudentPlacementHistory {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  studentId      String  @map("student_id")
  campusId       String  @map("campus_id") // where the student sat (WB1-6 scope target)
  classSectionId String? @map("class_section_id") // K-12 section (null = cohort/tertiary)
  academicYearId String? @map("academic_year_id")

  // 'registration' | 'transfer' | 'withdrawal' | 'graduation' | 'reinstatement' | 'promotion'
  eventType     String    @map("event_type")
  status        String    @default("active") // 'active' (current span) | 'ended'
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  reason        String?

  // The concrete SectionEnrollment this span reflects (K-12), when there is one.
  sectionEnrollmentId String? @map("section_enrollment_id")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, studentId])
  @@index([classSectionId])
  @@index([campusId])
  @@index([status])
  @@index([tenantId, studentId, status])
  @@map("student_placement_history")
  @@schema("student-management")
}

// ============================================
// WB2-4 · Promotion workbench (year rollover)
// ============================================
// Move a cohort to the next year in ONE reviewable operation. A PromotionRun is
// a from-(year/year-level) → to-(year/year-level) rollover; preview() materialises
// a PromotionRunItem per active student with a PROPOSED next placement; an admin
// marks per-student EXCEPTIONS (repeat / withhold / manual). The commit is a
// high-risk bulk mutation routed through the WB1-6 maker-checker (a SECOND
// approver, maker ≠ checker) — it creates NEXT-year SectionEnrollments +
// promotion placement-history rows and leaves the PRIOR year untouched
// (scenario 4). External ids are DB-level FKs validated in-service. RLS:
// own + platform.
// ============================================

model PromotionRun {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  campusId String? @map("campus_id") // scope target; null = tenant-wide

  name               String
  fromAcademicYearId String @map("from_academic_year_id")
  toAcademicYearId   String @map("to_academic_year_id")
  fromYearLevelId    String @map("from_year_level_id")
  toYearLevelId      String @map("to_year_level_id")

  // 'draft' | 'previewed' | 'pending_approval' | 'committed' | 'cancelled'
  status            String  @default("draft")
  approvalRequestId String? @map("approval_request_id") // MakerCheckerRequest id (WB1-6)

  previewedAt DateTime? @map("previewed_at")
  committedAt DateTime? @map("committed_at")
  committedBy String?   @map("committed_by")

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items PromotionRunItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([campusId])
  @@map("promotion_runs")
  @@schema("student-management")
}

model PromotionRunItem {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  runId     String @map("run_id")
  studentId String @map("student_id")

  fromClassSectionId     String? @map("from_class_section_id")
  proposedClassSectionId String? @map("proposed_class_section_id")

  // 'promote' | 'repeat' | 'withhold' | 'manual'
  decision String @default("promote")
  // 'pending' | 'committed' | 'skipped'
  status          String  @default("pending")
  exceptionReason String? @map("exception_reason")

  resultingEnrollmentId String? @map("resulting_enrollment_id")

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  run PromotionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, studentId])
  @@index([tenantId])
  @@index([runId])
  @@index([studentId])
  @@index([tenantId, runId])
  @@map("promotion_run_items")
  @@schema("student-management")
}
